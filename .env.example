# Copy this file to .env and fill in what you have. Every value is optional.
# With no key at all, the agent uses the built-in rules parser and makes no network calls.
# If both keys are set, Anthropic is used.

# Claude, via the Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5
ANTHROPIC_MODEL=

# Gemini, via the Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash
GEMINI_MODEL=
# low (default), medium or high. Lower is faster.
GEMINI_THINKING_LEVEL=
